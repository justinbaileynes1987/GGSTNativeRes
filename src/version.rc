#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GGSTNR_VERSION_MAJOR, GGSTNR_VERSION_MINOR, GGSTNR_VERSION_PATCH, 0
 PRODUCTVERSION GGSTNR_VERSION_MAJOR, GGSTNR_VERSION_MINOR, GGSTNR_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GGSTNativeRes"
#ifdef GGSTNR_PROXY_DSOUND
            VALUE "FileDescription",  "GGSTNativeRes - boot-time resolution fix for Guilty Gear -Strive-, Microsoft Store version (loads as dsound.dll proxy)"
            VALUE "OriginalFilename", "dsound.dll"
#else
            VALUE "FileDescription",  "GGSTNativeRes - boot-time resolution fix for Guilty Gear -Strive- (loads as xapofx1_5.dll proxy)"
            VALUE "OriginalFilename", "xapofx1_5.dll"
#endif
            VALUE "FileVersion",      GGSTNR_VERSION_STRING
            VALUE "InternalName",     "GGSTNativeRes"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "ProductName",      "GGSTNativeRes"
            VALUE "ProductVersion",   GGSTNR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
